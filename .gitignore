# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and editable install artifacts
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# IDE and editor files
.idea/
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Local runtime outputs
out/
runs/
logs/
tmp/
tmp*/
temp/
tmp_test_outputs/
tmp_test_decode/
.tmp-*/

# One-off local probe scripts
tmp_*.py

# Real acquisition samples (kept locally, not shipped in git)
samples/

# Waveform and acquisition scratch data
captures/
artifacts/

# PyInstaller executable builds
dist-exe/
.tmp-pyinstaller/
/*.spec

# Local profile overrides
profiles/*.local.yaml
profiles/*.private.yaml

# Stray vendored-script test run outputs
tests/.daq_cli_tmp/
tests/*_board_*/
